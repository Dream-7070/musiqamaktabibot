# ==========================
# school-bot.service - BITTA MAKTAB (eski joylashuv)
# ==========================
#
# /opt/school_bot ning O'ZI ishlayotgan maktab bo'lgan holat
# uchun. Ko'p maktab rejimida o'rniga school-bot@.service
# shabloni ishlatiladi (KOP_MAKTAB.md).
# ==========================

[Unit]
Description=Maktab hujjatlar boti
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/school_bot
ExecStart=/opt/school_bot/venv/bin/python main.py

# config.py .env ni o'zi ham o'qiydi, lekin birlik shablon
# variantidan farq qilmasligi uchun bu yerda ham beriladi -
# ikki fayl ajrab ketishining oldini oladi.
EnvironmentFile=/opt/school_bot/.env

# yiqilsa avtomatik qayta ishga tushadi
Restart=always
RestartSec=10

# loglar journalctl ga tushadi
StandardOutput=journal
StandardError=journal
SyslogIdentifier=school-bot

# print() darhol logga chiqsin
Environment=PYTHONUNBUFFERED=1

# VPS UTC'da ishlaydi. Busiz SEND_HOUR=10 aslida Toshkent
# vaqti bilan 15:00 bo'lib qolardi - "ertalabki" eslatma
# tushdan keyin ketardi. Oy chegarasidagi to'lovlar ham
# noto'g'ri oyga yozilishi mumkin edi.
Environment=TZ=Asia/Tashkent

# xavfsizlik chegaralari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/school_bot

[Install]
WantedBy=multi-user.target
