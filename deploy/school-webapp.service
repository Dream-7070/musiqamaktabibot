[Unit]
Description=Maktab Mini App (Flask/gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/school_bot

# gunicorn - ishlab chiqarish uchun (Flask dev server emas)
# 2 ta worker kifoya: yuk kam, SQLite bitta fayl
ExecStart=/opt/school_bot/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    webapp.server:app

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=school-webapp

Environment=PYTHONUNBUFFERED=1

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/school_bot

[Install]
WantedBy=multi-user.target
