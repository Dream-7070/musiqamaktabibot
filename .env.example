# ==========================
# .env.example
# ==========================
#
# Har maktab uchun shu fayldan nusxa olinadi:
#
#     cp .env.example .env
#
# va qiymatlar to'ldiriladi. `.env` HECH QACHON git'ga
# qo'shilmaydi - ichida bot tokeni bor.
#
# ==========================


# --- MAKTAB ---

# Texnik nom: papka, systemd servisi va subdomen shundan yasaladi.
# Faqat kichik lotin harflari va raqam. Masalan: 19bmsm -> 19bmsm.cybermate.uz
SCHOOL_SLUG=maktab

# Foydalanuvchi ko'radigan to'liq nom (bot va Mini App sarlavhasi)
SCHOOL_NAME=Bolalar musiqa va san'at maktabi


# --- TELEGRAM ---

# @BotFather dan olinadi. Har maktabning O'Z boti bo'ladi.
BOT_TOKEN=

# To'liq huquqli adminlar, vergul bilan. Telegram ID ni @userinfobot beradi.
ADMIN_IDS=


# --- MINI APP ---

# HTTPS bo'lishi SHART (Telegram talabi).
# Bo'sh qoldirilsa "Farzandim" tugmasi ko'rinmaydi, bot ishlayveradi.
WEBAPP_URL=

# gunicorn shu portda tinglaydi. Bir serverdagi HAR MAKTABGA
# boshqa port beriladi: 8000, 8001, 8002 ...
WEBAPP_PORT=8000


# --- BAZA ---

# Har maktabning o'z fayli. Yo'llar kesishmasligi shart!
DB_PATH=school.db


# --- GOOGLE DRIVE ---
#
# TAVSIYA ETILADIGAN USUL: SERVICE ACCOUNT
#
# Server uchun to'g'ri usul: brauzer, rozilik oynasi va token
# muddati YO'Q. Tartib:
#
#   1. Google Cloud Console -> IAM & Admin -> Service Accounts
#      -> yangi yarating -> Keys -> Add key -> JSON -> yuklab oling
#   2. Faylni maktab papkasiga service_account.json nomi bilan qo'ying
#   3. Drive'da arxiv papkasini oching, service account manziliga
#      (xxx@yyy.iam.gserviceaccount.com) "Muharrir" huquqi bilan ulashing
#   4. Papka manzilidagi /folders/<ID> qismini shu yerga yozing
#
# Service account O'Z Drive'iga ega emas - shuning uchun unga
# tayyor papkaning ID si berilishi SHART.

GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
DRIVE_ROOT_FOLDER_ID=

# --- ESKI USUL: OAUTH (odam nomidan) ---
#
# Yuqoridagi GOOGLE_SERVICE_ACCOUNT_FILE to'ldirilgan bo'lsa
# bular ishlatilmaydi.
#
# DIQQAT: ilova Google Cloud'da "Testing" holatida bo'lsa,
# token HAR 7 KUNDA o'ladi va qayta olish kerak bo'ladi.

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
DRIVE_ROOT_FOLDER=Maktab arxivi
