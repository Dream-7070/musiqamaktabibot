[Unit]
Description=Maktab Mini App (Flask/gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/school_bot

# gunicorn - ishlab chiqarish uchun (Flask dev server emas)
# 2 ta worker kifoya: yuk kam, SQLite bitta fayl
ExecStart=/opt/school_bot/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    webapp.server:app

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=school-webapp

Environment=PYTHONUNBUFFERED=1

# VPS UTC'da ishlaydi. Busiz SEND_HOUR=10 aslida Toshkent
# vaqti bilan 15:00 bo'lib qolardi - "ertalabki" eslatma
# tushdan keyin ketardi. Oy chegarasidagi to'lovlar ham
# noto'g'ri oyga yozilishi mumkin edi.
Environment=TZ=Asia/Tashkent

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/school_bot

[Install]
WantedBy=multi-user.target
