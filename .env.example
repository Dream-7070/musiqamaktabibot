# ==========================
# .env.example
# ==========================
#
# Har maktab uchun shu fayldan nusxa olinadi:
#
#     cp .env.example .env
#
# va qiymatlar to'ldiriladi. `.env` HECH QACHON git'ga
# qo'shilmaydi - ichida bot tokeni bor.
#
# ==========================


# --- MAKTAB ---

# Texnik nom: papka, systemd servisi va subdomen shundan yasaladi.
# Faqat kichik lotin harflari va raqam. Masalan: 19bmsm -> 19bmsm.cybermate.uz
SCHOOL_SLUG=maktab

# Foydalanuvchi ko'radigan to'liq nom (bot va Mini App sarlavhasi)
SCHOOL_NAME=Bolalar musiqa va san'at maktabi


# --- TELEGRAM ---

# @BotFather dan olinadi. Har maktabning O'Z boti bo'ladi.
BOT_TOKEN=

# To'liq huquqli adminlar, vergul bilan. Telegram ID ni @userinfobot beradi.
ADMIN_IDS=


# --- MINI APP ---

# HTTPS bo'lishi SHART (Telegram talabi).
# Bo'sh qoldirilsa "Farzandim" tugmasi ko'rinmaydi, bot ishlayveradi.
WEBAPP_URL=

# gunicorn shu portda tinglaydi. Bir serverdagi HAR MAKTABGA
# boshqa port beriladi: 8000, 8001, 8002 ...
#
# Bu qiymat nginx bilan MOS bo'lishi shart (ko'p maktab rejimida
# /etc/nginx/school-ports.map, bitta maktabda esa proxy_pass).
# new_school.sh ikkalasini birga yozadi; qo'lda o'zgartirsangiz
# ikki joyni ham o'zgartiring - aks holda Mini App 502 beradi.
# deploy/update.sh har yangilanishda buni tekshiradi.
WEBAPP_PORT=8000


# --- BAZA ---

# Har maktabning o'z fayli. Yo'llar kesishmasligi shart!
DB_PATH=school.db


# --- GOOGLE DRIVE ---
#
# ODATDAGI USUL: OAUTH (odam nomidan)
#
# Maktabning Drive'i oddiy Gmail akkaunti bo'lsa - yagona
# ishlaydigan yo'l shu. Tartib:
#
#   1. Google Cloud Console -> APIs & Services -> Credentials
#      -> OAuth client ID (Desktop app) -> credentials.json yuklab oling
#   2. Faylni maktab papkasiga credentials.json nomi bilan qo'ying
#   3. Kompyuteringizda: python scripts/get_token.py
#      (brauzerda maktab akkaunti bilan tasdiqlaysiz)
#   4. Hosil bo'lgan token.json ni maktab papkasiga ko'chiring
#
# DIQQAT: ilova Google Cloud'da "Testing" holatida qolsa token
# HAR 7 KUNDA o'ladi. OAuth consent screen -> "PUBLISH APP"
# bilan "In production" ga o'tkazing - shundan keyin muddatsiz.

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
DRIVE_ROOT_FOLDER=Maktab arxivi


# --- SERVICE ACCOUNT: FAQAT GOOGLE WORKSPACE + SHARED DRIVE ---
#
# Brauzer va token muddati yo'q, lekin SHAXSIY GMAIL BILAN
# ISHLAMAYDI - amalda sinalgan. Service account'ning o'z Drive
# kvotasi yo'q: papka yaratadi, fayl yuklashda esa Google 403
# "Service Accounts do not have storage quota" qaytaradi.
# Nosozlik faqat birinchi fayl yuklaganda bilinadi.
#
# Maktab Google Workspace ishlatsa va arxiv Shared Drive
# (umumiy disk) ichida bo'lsa - o'sha holda to'g'ri ishlaydi,
# chunki fayl egasi tashkilot bo'ladi. Faqat o'shanda to'ldiring:
#
#   1. Google Cloud Console -> IAM & Admin -> Service Accounts
#      -> Keys -> Add key -> JSON -> yuklab oling
#   2. Faylni service_account.json nomi bilan maktab papkasiga qo'ying
#   3. Shared Drive papkasini service account manziliga
#      (xxx@yyy.iam.gserviceaccount.com) "Muharrir" qilib ulashing
#   4. Papka manzilidagi /folders/<ID> qismini quyiga yozing
#
# Bo'sh qoldirilsa OAuth ishlatiladi (yuqoridagi usul).

GOOGLE_SERVICE_ACCOUNT_FILE=
DRIVE_ROOT_FOLDER_ID=
