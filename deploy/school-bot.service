[Unit]
Description=Maktab hujjatlar boti
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/school_bot
ExecStart=/opt/school_bot/venv/bin/python main.py

# yiqilsa avtomatik qayta ishga tushadi
Restart=always
RestartSec=10

# loglar journalctl ga tushadi
StandardOutput=journal
StandardError=journal
SyslogIdentifier=school-bot

# print() darhol logga chiqsin
Environment=PYTHONUNBUFFERED=1

# xavfsizlik chegaralari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/school_bot

[Install]
WantedBy=multi-user.target
